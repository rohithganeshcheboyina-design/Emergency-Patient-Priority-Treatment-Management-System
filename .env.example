# ==============================================================================
# Hospital Emergency Patient Priority Management System (HE-PPMS)
# Environment Configuration Template (.env.example)
#
# Copy this file to .env or update src/main/resources/config.properties
# NEVER commit your production passwords or secret keys to version control!
# ==============================================================================

# Database Persistence Engine (mysql | h2)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hospital_emergency_system
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_URL=jdbc:mysql://localhost:3306/hospital_emergency_system?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# System Waiting Time Overdue Alert Thresholds (Minutes)
CRITICAL_WAIT_THRESHOLD_MIN=15
HIGH_WAIT_THRESHOLD_MIN=30
MEDIUM_WAIT_THRESHOLD_MIN=60
LOW_WAIT_THRESHOLD_MIN=120

# UI Live Telemetry Refresh Cadence (Seconds)
QUEUE_AUTO_REFRESH_SECONDS=10
